# =============================================================================
#  CONFIGURACION LOCAL DEL BACKEND          (.env.example  ->  copialo como ".env")
# =============================================================================
#  - ".env" NO se sube a git (esta en .gitignore): ahi van las claves reales.
#  - Con "docker compose up -d --build" NO necesitas este archivo.
#  - Lo necesitas cuando corres el backend desde IntelliJ / gradle, o cuando
#    quieres cambiar puertos o claves del docker-compose.
#
#  REGLAS PARA NO ROMPERLO  (Spring lo lee como un archivo .properties de Java)
#    1. Una variable por linea:  NOMBRE=valor
#    2. El valor va SOLO: sin comillas, sin comandos pegados, sin texto detras
#       y sin espacios sobrando al final de la linea.
#           DB_PASSWORD=cd "C:\Proyect..."   MAL: Spring usa ese texto como contrasena
#           ML_API_KEY=abc123 mi clave       MAL: " mi clave" pasa a ser parte de la clave
#    3. Los comentarios van en su propia linea, empezando con "#".
#       Nunca al lado de un valor.
#    4. Evita "\" dentro de los valores (en este formato es un caracter de escape).
#    5. El archivo se llama exactamente ".env" (no ".env.txt": en Windows activa
#       "Extensiones de nombre de archivo" para comprobarlo) y esta en la carpeta
#       del backend, junto a build.gradle.kts.
#    6. Reinicia el backend despues de cada cambio: solo se lee al arrancar.
#    7. Las claves reales NO se pegan en chats, issues ni PRs. Se comparten
#       por un canal privado.
#
#  COMO COMPROBAR A QUE BASE SE CONECTO:  al arrancar, busca en el log la linea
#           Database JDBC URL [jdbc:mysql://...]
#  Si dice localhost:3307 y esperabas Aiven, el .env no se esta leyendo
#  (regla 5, o IntelliJ corre con otra carpeta de trabajo: debe ser la del backend).
# =============================================================================


# -----------------------------------------------------------------------------
#  BASE DE DATOS  -  deja SOLO UNA opcion activa (si dejas las dos, gana la ultima)
# -----------------------------------------------------------------------------

# OPCION A (por defecto): MySQL local del docker-compose.
#   Antes de arrancar:  docker compose up -d mysql-db
#   APP_SEED_ENABLED=true crea el usuario superadmin / Admin12345! y los catalogos
#   basicos en una base NUEVA. Solo para bases locales.
DB_URL=jdbc:mysql://localhost:3307/security_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=root
APP_SEED_ENABLED=true

# OPCION B: base compartida del equipo en Aiven.
#   Para usarla: comenta las 4 lineas de la opcion A y quita el "# " de estas 4.
#   Pide al responsable el host, el puerto y la contrasena (la contrasena, por privado).
#   Donde estan: consola de Aiven -> tu servicio MySQL -> Overview -> Connection information.
#     - Aiven exige SSL: deja sslMode=REQUIRED.
#     - La contrasena de Aiven empieza con "AVNS_". Pegala SOLA en la linea.
#     - La base debe existir en Aiven (pestana Databases). Aqui se usa security_db.
#     - OJO: con ddl-auto=update cada version del codigo modifica el esquema de TODOS.
#       Contra Aiven corre solo la rama main; para probar ramas usa la opcion A.
# DB_URL=jdbc:mysql://<host>:<puerto>/security_db?sslMode=REQUIRED&serverTimezone=UTC
# DB_USER=avnadmin
# DB_PASSWORD=
# APP_SEED_ENABLED=false


# -----------------------------------------------------------------------------
#  MICROSERVICIO DE ML  (repositorio Security-MachineLearning)  -  opcional
# -----------------------------------------------------------------------------
# ML_API_KEY debe ser IGUAL a INTERNAL_API_KEY del ML (ambos repos usan la misma por defecto).
ML_BASE_URL=http://localhost:8000
ML_API_KEY=dev-internal-key-change-me


# -----------------------------------------------------------------------------
#  SEGURIDAD Y CORS
# -----------------------------------------------------------------------------
# Firma de los tokens JWT. Minimo 32 caracteres. Si no la defines se usa una clave fija de desarrollo.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789

# Origenes del frontend permitidos por CORS (separados por coma). Por defecto: http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000


# -----------------------------------------------------------------------------
#  SOLO PARA EL DOCKER-COMPOSE: puertos en tu PC (cambialos si alguno esta ocupado)
# -----------------------------------------------------------------------------
# Si cambias MYSQL_PORT, cambialo tambien en DB_URL.
# MYSQL_PORT=3307
# BACKEND_PORT=8081
# PHPMYADMIN_PORT=8082
# ML_PORT=8000


# -----------------------------------------------------------------------------
#  ALMACENAMIENTO DE ARCHIVOS  (canal de denuncias)
# -----------------------------------------------------------------------------
# local | oracle  ->  con "local" los archivos se guardan en STORAGE_LOCAL_BASE_PATH.
STORAGE_PROVIDER=local
STORAGE_LOCAL_BASE_PATH=./storage

# Solo si usas Oracle Object Storage.
OCI_REGION=
OCI_NAMESPACE=
OCI_BUCKET=
# CONFIG_FILE | INSTANCE_PRINCIPAL
OCI_AUTH_MODE=CONFIG_FILE
# Opcional. Si se deja vacio, OCI usa ~/.oci/config
OCI_CONFIG_FILE=
OCI_PROFILE=DEFAULT


# -----------------------------------------------------------------------------
#  ERRORES FRECUENTES
# -----------------------------------------------------------------------------
#  Access denied for user 'avnadmin'      -> contrasena mal pegada (regla 2) o cambiada.
#  Communications link failure            -> opcion A: Docker apagado.
#                                            opcion B: tu IP no esta en "Allowed IP addresses"
#                                            del servicio en la consola de Aiven.
#  Unknown database 'security_db'         -> esa base no existe en el servidor (pestana Databases).
#  Se conecta a localhost:3307, no a Aiven -> el .env no se esta leyendo (regla 5).
#  El frontend dice que el backend no levanto -> en el repo del frontend falta .env.local con
#                                            NEXT_PUBLIC_API_URL=http://localhost:8081/api
