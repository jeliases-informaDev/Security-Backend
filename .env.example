# Copia este archivo como ".env" en la raíz de Security-Backend y completa la contraseña.
# El backend lo lee automáticamente al arrancar. ".env" no se sube a git.
DB_URL=jdbc:mysql://security-dev-huancayo.g.aivencloud.com:19580/security_db?sslMode=REQUIRED&serverTimezone=UTC
DB_USER=avnadmin
DB_PASSWORD=<pide la contraseña al responsable>

# Microservicio de Machine Learning (Indira, casos en prensa). La clave debe ser la misma que INTERNAL_API_KEY del ML.
ML_BASE_URL=http://localhost:8000
ML_API_KEY=<pide la clave al responsable>
