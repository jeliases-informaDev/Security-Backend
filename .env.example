# TODO ES OPCIONAL: con "docker compose up -d --build" no necesitas este archivo.
#
# Copialo como ".env" en esta carpeta cuando:
#   - corras el backend desde IntelliJ / gradle (lo lee Spring al arrancar), o
#   - quieras cambiar puertos o claves del docker-compose.
# ".env" no se sube a git.

# ---- Conexion a MySQL (al correr desde IntelliJ). Apunta a la MySQL del docker-compose:  docker compose up -d mysql-db
DB_URL=jdbc:mysql://localhost:3307/security_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=root

# ---- Microservicio de ML (repositorio Security-MachineLearning). Opcional.
# ML_API_KEY debe ser igual a INTERNAL_API_KEY del ML (ambos repos usan la misma por defecto).
ML_BASE_URL=http://localhost:8000
ML_API_KEY=dev-internal-key-change-me

# Firma de los tokens JWT. Minimo 32 caracteres. Si no la defines se usa una clave fija de desarrollo.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789

# Crea el usuario superadmin / Admin12345! y los catalogos basicos en una base NUEVA. Solo para bases locales.
APP_SEED_ENABLED=true

# Origenes del frontend permitidos por CORS (separados por coma). Por defecto: http://localhost:3000
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Solo para el docker-compose: puertos en tu PC (cambialos si alguno esta ocupado).
# Si cambias MYSQL_PORT, cambialo tambien en DB_URL.
# MYSQL_PORT=3307
# BACKEND_PORT=8081
# PHPMYADMIN_PORT=8082
# ML_PORT=8000

# ---- Alternativa: base compartida en Aiven (pide host, puerto y clave al responsable) ----
# OJO: con ddl-auto=update cada version del codigo modifica el esquema de TODOS. Mejor usa la local.
# DB_URL=jdbc:mysql://<host>:<puerto>/security_db?sslMode=REQUIRED&serverTimezone=UTC
# DB_USER=avnadmin
# DB_PASSWORD=<pide la contraseña al responsable>
# APP_SEED_ENABLED=false
